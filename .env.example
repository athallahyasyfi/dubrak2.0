# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Outlet untuk Konfirmasi & Bukti Pembayaran QRIS (Gunakan format 628...)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Kredensial Awal Staff (Disimpan & di-hash PBKDF2 di server, dapat diubah langsung dari UI Admin/Kasir)
KASIR_USERNAME=kasir
KASIR_PASSWORD=ganti_password_kasir
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_admin
AUTH_SECRET=ganti_dengan_secret_key_acak_minimal_32_karakter
